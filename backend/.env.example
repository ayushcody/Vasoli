SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_JWT_SECRET=""
DATABASE_URL=""

# Set ENV=production on hosted services; never enable BYPASS_AUTH there.
ENV="development"
SERVER_ADDR=":8080"
CORS_ORIGINS="http://localhost:3000"

# Supabase public-key verification. Legacy HS256 requires the explicit secret above.
SUPABASE_JWT_ISSUER=""
SUPABASE_JWT_AUDIENCE="authenticated"
SUPABASE_JWKS_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
BYPASS_AUTH="false"
# Disabled unless explicitly configured; local Mailpit uses 127.0.0.1:55425.
ENABLE_EMAIL_NOTIFICATIONS="false"
SMTP_ADDR=""
SMTP_FROM=""
SMTP_USERNAME=""
SMTP_PASSWORD=""
